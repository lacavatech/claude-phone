# ====================================
# Claude Phone Configuration
# ====================================
# Copy this to .env and fill in your values

# ====================================
# Network Configuration
# ====================================

# Your server's LAN IP (CRITICAL for RTP audio)
# This IP goes into SDP packets so the PBX knows where to send audio
EXTERNAL_IP=10.0.0.100

# ====================================
# Drachtio Configuration
# ====================================

DRACHTIO_HOST=127.0.0.1
DRACHTIO_PORT=9022
DRACHTIO_SECRET=cymru

# SIP port for Contact header
# Use 5070 if another SIP process (3CX SBC, Asterisk, FreePBX) is already on 5060
# This MUST match the port in docker-compose.yml drachtio command
DRACHTIO_SIP_PORT=5060

# ====================================
# FreeSWITCH Configuration
# ====================================

FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
FREESWITCH_SECRET=JambonzR0ck$

# ====================================
# SIP Configuration (3CX, FreePBX, Asterisk, etc.)
# ====================================

# Your PBX server hostname or IP
SIP_DOMAIN=pbx.example.com
SIP_REGISTRAR=10.0.0.50

# Default extension for inbound/outbound calls
SIP_EXTENSION=9000
SIP_PASSWORD=your-sip-password

# SIP auth username (optional):
#   - 3CX: set this to the "Auth ID" shown in the extension settings
#   - FreePBX / Asterisk: leave blank — the extension number is used as the auth username
# SIP_USERNAME=your-auth-username

# Default caller ID for outbound PSTN calls
DEFAULT_CALLER_ID=+15551234567

# ====================================
# Outbound Call Settings
# ====================================

# PSTN dial prefix (optional):
#   - 3CX: set to "9" (3CX requires a leading 9 to route external calls via trunk)
#   - FreePBX / Asterisk: leave blank — outbound routes handle PSTN routing directly
# OUTBOUND_PSTN_PREFIX=

# SIP trunk host for outbound calls (required if making outbound calls)
# SIP_TRUNK_HOST=10.0.0.50

# ====================================
# Claude API Server
# ====================================

# URL to your Claude API server (runs on your API server with Claude Max)
CLAUDE_API_URL=http://10.0.0.200:3333

# ====================================
# ElevenLabs TTS
# ====================================

ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Default voice ID (if not specified per-device)
ELEVENLABS_VOICE_ID=your-default-voice-id

# ====================================
# OpenAI (Whisper STT)
# ====================================

OPENAI_API_KEY=your-openai-api-key

# ====================================
# Application Settings
# ====================================

# HTTP server port for API and audio file serving
HTTP_PORT=3000

# WebSocket port for audio streaming from FreeSWITCH
WS_PORT=3001

# Audio files directory
AUDIO_DIR=/app/audio

# Maximum conversation turns for outbound calls
MAX_CONVERSATION_TURNS=10

# Ring timeout in seconds
OUTBOUND_RING_TIMEOUT=30

# ====================================
# Optional: Debug
# ====================================

# DEBUG=voice-app:*
